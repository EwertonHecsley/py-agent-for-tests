# Para Google AI Studio, informe sua chave abaixo.
GOOGLE_API_KEY=cole_sua_chave_aqui

# Use FALSE para Google AI Studio. Para Vertex AI, use TRUE e configure
# as credenciais e variáveis exigidas pelo seu ambiente Google Cloud.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Informe um modelo disponível na sua conta.
MODEL_NAME=nome_do_modelo_aqui

# A instrução é obrigatória. Use \n para representar quebras de linha.
AGENT_INSTRUCTION=Você é um especialista em testes Node.js.\nLeia o código antes de criar testes.\nCrie testes unitários e E2E quando apropriado.\nNão sobrescreva arquivos sem confirmação.

# Limites opcionais, em segundos.
TEST_TIMEOUT_SECONDS=120
INSTALL_TIMEOUT_SECONDS=180
